{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  // client/ e server/ restano esclusi finché `preact` e `lakebed` non sono
  // risolvibili da node_modules (li fornisce il runtime Lakebed, non npm).
  "include": ["shared", "tests"],
  "exclude": ["node_modules"]
}
